static void anonymous_pipe_demo(void)
{
    int p[2];

    pid_t child;

    const char msg[] =
        "Anonymous pipe: child sent this message.";

    char buf[128] = {0};

    if (pipe(p) != 0)
    {
        perror("pipe");
        return;
    }

    child = fork();

    if (child < 0)
    {
        perror("fork");

        close(p[0]);
        close(p[1]);

        return;
    }

    if (child == 0)
    {
        ssize_t n;

        close(p[0]);

        n = write(p[1],
                  msg,
                  sizeof(msg) - 1);

        if (n < 0)
            perror("pipe write");

        close(p[1]);

        _exit(0);
    }

    close(p[1]);

    {
        ssize_t n =
            read(p[0],
                 buf,
                 sizeof(buf) - 1);

        if (n < 0)
        {
            perror("pipe read");
        }
        else if (n > 0)
        {
            buf[n] = '\0';

            printf("Anonymous pipe received: %s\n",
                   buf);
        }
    }

    close(p[0]);

    (void)waitpid(child,
                  NULL,
                  0);
}

static void named_fifo_demo(void)
{
    pid_t child;

    int fd;

    char buf[128] = {0};

    const char msg[] =
        "Named FIFO: child sent this message.";

    if (mkfifo(FIFO_PATH,
               0600) != 0 &&
        errno != EEXIST)
    {
        perror("mkfifo");
        return;
    }

    child = fork();

    if (child < 0)
    {
        perror("fork");

        unlink(FIFO_PATH);

        return;
    }

    if (child == 0)
    {
        ssize_t n;

        fd = open(FIFO_PATH,
                  O_WRONLY);

        if (fd < 0)
        {
            perror("FIFO child open");
            _exit(1);
        }

        n = write(fd,
                  msg,
                  sizeof(msg) - 1);

        if (n < 0)
            perror("FIFO write");

        close(fd);

        _exit(0);
    }

    fd = open(FIFO_PATH,
              O_RDONLY);

    if (fd < 0)
    {
        perror("FIFO parent open");
    }
    else
    {
        ssize_t n =
            read(fd,
                 buf,
                 sizeof(buf) - 1);

        if (n < 0)
        {
            perror("FIFO read");
        }
        else if (n > 0)
        {
            buf[n] = '\0';

            printf("Named FIFO received: %s\n",
                   buf);
        }

        close(fd);
    }

    (void)waitpid(child,
                  NULL,
                  0);

    unlink(FIFO_PATH);
}

static void signal_demo(void)
{
    struct sigaction sa;

    memset(&sa,
           0,
           sizeof(sa));

    sa.sa_handler = sigusr1_handler;

    sigemptyset(&sa.sa_mask);

    if (sigaction(SIGUSR1,
                  &sa,
                  NULL) != 0)
    {
        perror("sigaction");
        return;
    }

    g_signal_count = 0;

    printf("Current PID: %ld\n",
           (long)getpid());

    if (kill(getpid(),
             SIGUSR1) != 0)
    {
        perror("kill");
    }

    printf("SIGUSR1 handler count: %d\n",
           (int)g_signal_count);
}

static void co3_ipc_demo(void)
{
    clear_screen();

    printf("==================== CO-3: IPC ====================\n\n");

    printf("1. Anonymous pipe\n");

    anonymous_pipe_demo();

    printf("\n2. Named pipe (FIFO)\n");

    named_fifo_demo();

    printf("\n3. Signal / asynchronous notification\n");

    signal_demo();

    printf("\n4. Process group / session information\n");

    printf("PID     : %ld\n",
