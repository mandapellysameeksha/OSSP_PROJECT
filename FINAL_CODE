static int read_cpu(unsigned long long *total,
                    unsigned long long *idle)
{
    FILE *f;

    unsigned long long user = 0;
    unsigned long long nicev = 0;
    unsigned long long system = 0;
    unsigned long long idlev = 0;
    unsigned long long iowait = 0;
    unsigned long long irq = 0;
    unsigned long long softirq = 0;
    unsigned long long steal = 0;

    f = fopen("/proc/stat", "r");

    if (f == NULL)
        return -1;

    if (fscanf(f,
               "cpu %llu %llu %llu %llu %llu %llu %llu %llu",
               &user,
               &nicev,
               &system,
               &idlev,
               &iowait,
               &irq,
               &softirq,
               &steal) != 8)
    {
        fclose(f);
        return -1;
    }

    fclose(f);

    *idle = idlev + iowait;

    *total =
        user +
        nicev +
        system +
        idlev +
        iowait +
        irq +
        softirq +
        steal;

    return 0;
}

static double cpu_usage_once(unsigned int delay_seconds)
{
    unsigned long long t1;
    unsigned long long t2;

    unsigned long long i1;
    unsigned long long i2;

    struct timespec ts;

    if (read_cpu(&t1, &i1) != 0)
        return -1.0;

    ts.tv_sec = (time_t)delay_seconds;
    ts.tv_nsec = 0;

    while (nanosleep(&ts, &ts) == -1 && errno == EINTR)
    {
    }

    if (read_cpu(&t2, &i2) != 0)
        return -1.0;

    if (t2 <= t1)
        return -1.0;

    return 100.0 *
           ((double)(t2 - t1) -
            (double)(i2 - i1)) /
           (double)(t2 - t1);
}

static int read_memory(unsigned long long *total_kb,
                       unsigned long long *available_kb)
{
    FILE *f;

    char key[64];
    char unit[32];

    unsigned long long value;

    *total_kb = 0;
    *available_kb = 0;

    f = fopen("/proc/meminfo", "r");

    if (f == NULL)
        return -1;

    while (fscanf(f,
                  "%63s %llu %31s",
                  key,
                  &value,
                  unit) == 3)
    {
        if (strcmp(key, "MemTotal:") == 0)
            *total_kb = value;

        if (strcmp(key, "MemAvailable:") == 0)
            *available_kb = value;
    }

    fclose(f);

    if (*total_kb > 0 && *available_kb > 0)
        return 0;

    return -1;
}

static double load_average(void)
{
    FILE *f;

    double a = 0.0;
    double b = 0.0;
    double c = 0.0;

    int rc;

    f = fopen("/proc/loadavg", "r");

    if (f == NULL)
        return -1.0;

    rc = fscanf(f,
                "%lf %lf %lf",
                &a,
                &b,
                &c);

    fclose(f);

    if (rc != 3)
        return -1.0;

    return a;
}

static const char *scheduler_name(int policy)
{
    switch (policy)
    {
        case SCHED_OTHER:
            return "SCHED_OTHER";

        case SCHED_FIFO:
            return "SCHED_FIFO";

        case SCHED_RR:
            return "SCHED_RR";

#ifdef SCHED_BATCH
        case SCHED_BATCH:
            return "SCHED_BATCH";
#endif

#ifdef SCHED_IDLE
        case SCHED_IDLE:
            return "SCHED_IDLE";
#endif

        default:
            return "UNKNOWN";
    }
}

static void show_system_info(void)
{
    struct utsname u;

    char hostname[256];

    FILE *f;

    double uptime = 0.0;

    unsigned long long total_kb;
    unsigned long long avail_kb;

    struct statvfs vfs;

    int policy;

    struct sched_param sp;

    clear_screen();

    printf("===============================================================\n");
    printf("        LINUX SYSTEM INFORMATION & RESOURCE MONITOR\n");
    printf("                         FINAL VERSION\n");
    printf("===============================================================\n\n");

    /*
     * CO-1:
     * Linux provides system services through system calls.
     * User-space programs communicate with kernel services.
     */

    printf("[ SYSTEM / OS SERVICE LAYER ]\n");

    if (uname(&u) == 0)
    {
        if (gethostname(hostname, sizeof(hostname)) != 0)
        {
            snprintf(hostname,
                     sizeof(hostname),
                     "unknown");
        }

        hostname[sizeof(hostname) - 1] = '\0';

        printf("OS                 : %s\n",
               u.sysname);

        printf("Kernel             : %s\n",
               u.release);

        printf("Architecture       : %s\n",
               u.machine);

        printf("Hostname           : %s\n",
               hostname);
    }

    f = fopen("/proc/uptime", "r");

    if (f != NULL)
    {
        if (fscanf(f, "%lf", &uptime) == 1)
        {
            printf("Uptime             : %.2f hours\n",
                   uptime / 3600.0);
        }

        fclose(f);
    }

    printf("Current PID        : %ld\n",
           (long)getpid());

    printf("Parent PID         : %ld\n",
           (long)getppid());

    printf("Process Group      : %ld\n",
           (long)getpgrp());

    printf("Session ID         : %ld\n",
           (long)getsid(0));

    policy = sched_getscheduler(0);

    if (policy >= 0 &&
        sched_getparam(0, &sp) == 0)
    {
        printf("Scheduler           : %s\n",
               scheduler_name(policy));

        printf("Scheduling priority : %d\n",
               sp.sched_priority);
    }

    printf("\n[ RESOURCE UTILIZATION ]\n");

    {
        double cpu = cpu_usage_once(1);

        if (cpu >= 0)
        {
            printf("CPU usage           : %.2f %%\n",
                   cpu);
        }
        else
        {
            printf("CPU usage           : unavailable\n");
        }
    }

    if (read_memory(&total_kb,
                    &avail_kb) == 0)
    {
        double used =
            100.0 *
            (double)(total_kb - avail_kb) /
            (double)total_kb;

        printf("Memory usage        : %.2f %%\n",
               used);

        printf("Memory used         : %.2f MB\n",
               (total_kb - avail_kb) / 1024.0);

        printf("Total memory        : %.2f MB\n",
               total_kb / 1024.0);
    }

    printf("Load average (1m)   : %.2f\n",
           load_average());

    if (statvfs("/", &vfs) == 0)
    {
        unsigned long long total =
            (unsigned long long)vfs.f_blocks *
            vfs.f_frsize;

        unsigned long long freeb =
            (unsigned long long)vfs.f_bavail *
            vfs.f_frsize;

        if (total > 0)
        {
            printf("Root disk usage     : %.2f %%\n",
                   100.0 *
                   (double)(total - freeb) /
                   (double)total);
        }
    }

    printf("\n[ ACTIVE PROCESSES ]\n");

    printf("PID      PPID     STATE    COMMAND\n");
    printf("-----------------------------------------------\n");

    {
        FILE *ps;

        char line[256];

        ps = popen(
            "ps -eo pid,ppid,state,comm --sort=-%cpu | head -n 8",
            "r");

        if (ps != NULL)
        {
            while (fgets(line,
                         sizeof(line),
                         ps) != NULL)
            {
                fputs(line, stdout);
            }

            (void)pclose(ps);
        }
    }

    printf("\n---------------------------------------------------------------\n");

    printf("Keys: [h] help  [p] processes  [i] IPC  [m] memory\n");
    printf("     [f] files  [t] threads  [r] refresh  [q] quit\n");

    printf("Auto monitor refresh interval: %d seconds\n",
           REFRESH_SECONDS);
}

/* ============================================================
   CO-2: PROCESSES AND PROCESS CONTROL
   ============================================================ */

static void co2_process_demo(void)
{
    int p[2];

    pid_t child;

    int status;

    char buf[128] = {0};

    const char msg[] =
        "Child -> Parent: process IPC message";

    clear_screen();

    printf("================ CO-2: PROCESS CONTROL ================\n\n");

    printf("Parent PID: %ld\n",
           (long)getpid());

    printf("Creating child with fork()...\n");

    if (pipe(p) != 0)
    {
        perror("pipe");
        return;
    }

    child = fork();

    if (child < 0)
    {
        perror("fork");

        close(p[0]);
        close(p[1]);

        return;
    }

    if (child == 0)
    {
        ssize_t n;

        close(p[0]);

        n = write(p[1],
                  msg,
                  sizeof(msg) - 1);

        if (n < 0)
            perror("child write");

        close(p[1]);

        /*
         * exec() replaces the current process image.
         */

        execlp("uname",
               "uname",
               "-srm",
               (char *)NULL);

        perror("execlp");

        _exit(127);
    }

    close(p[1]);

    {
        ssize_t n =
            read(p[0],
                 buf,
                 sizeof(buf) - 1);

        if (n < 0)
        {
            perror("parent read");
        }
        else if (n > 0)
        {
            buf[n] = '\0';

            printf("Message received before exec: %s\n",
                   buf);
        }
    }

    close(p[0]);

    printf("Parent waiting with waitpid(%ld)...\n",
           (long)child);

    if (waitpid(child,
                &status,
                0) < 0)
    {
        perror("waitpid");
        return;
    }

    if (WIFEXITED(status))
    {
        printf("Child terminated normally, "
               "exit status=%d\n",
               WEXITSTATUS(status));
    }
    else if (WIFSIGNALED(status))
    {
        printf("Child terminated by signal %d\n",
               WTERMSIG(status));
    }

    printf("\n");
    printf("Demonstrated:\n");
    printf("fork()    -> process creation\n");
    printf("exec()    -> process execution\n");
    printf("waitpid() -> process synchronization\n");
    printf("exit      -> process termination\n");

    printf("\nScheduling policy: %s\n",
           scheduler_name(
               sched_getscheduler(0)));

    printf("Priority (nice): %d\n",
           getpriority(PRIO_PROCESS, 0));
}

