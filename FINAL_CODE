/* ============================================================
   MAIN
   ============================================================ */

int main(void)
{
    struct sigaction sa;

    char command[32];

    memset(&sa,
           0,
           sizeof(sa));

    sa.sa_handler = sigint_handler;

    sigemptyset(&sa.sa_mask);

    if (sigaction(SIGINT,
                  &sa,
                  NULL) != 0)
    {
        perror("sigaction");
        return EXIT_FAILURE;
    }

    while (g_running)
    {
        show_system_info();

        printf("\nCommand: ");

        fflush(stdout);

        if (fgets(command,
                  sizeof(command),
                  stdin) == NULL)
        {
            break;
        }

        switch (command[0])
        {
            case 'h':
            case 'H':
                show_help();
                wait_for_enter();
                break;

            case 'p':
            case 'P':
                co2_process_demo();
                wait_for_enter();
                break;

            case 'i':
            case 'I':
                co3_ipc_demo();
                wait_for_enter();
                break;

            case 'm':
            case 'M':
                co4_memory_demo();
                wait_for_enter();
                break;

            case 'f':
            case 'F':
                co5_file_demo();
                wait_for_enter();
                break;

            case 't':
            case 'T':
                co6_thread_demo();
                wait_for_enter();
                break;

            case 'r':
            case 'R':
                break;

            case 'q':
            case 'Q':
                g_running = 0;
                break;

            default:
                printf("Unknown command. Press h for help.\n");
                sleep(1);
                break;
        }
    }

    printf("\nSystem monitor stopped safely.\n");

    return EXIT_SUCCESS;
}
