    printf("\nIPC demonstration completed safely.\n");
}

/* ============================================================
   CO-4: MEMORY MANAGEMENT
   ============================================================ */

static void co4_memory_demo(void)
{
    unsigned long long total;
    unsigned long long avail;

    FILE *maps;

    char line[256];

    size_t page_size;

    void *region;

    char *heap_data;

    size_t region_size;

    clear_screen();

    printf("================= CO-4: MEMORY =================\n\n");

    page_size =
        (size_t)sysconf(_SC_PAGESIZE);

    printf("Page size              : %zu bytes\n",
           page_size);

    if (read_memory(&total,
                    &avail) == 0)
    {
        printf("Physical memory        : %.2f MB\n",
               total / 1024.0);

        printf("Available memory       : %.2f MB\n",
               avail / 1024.0);
    }

    printf("\nProcess virtual memory areas ");
    printf("(/proc/self/maps):\n");

    maps = fopen("/proc/self/maps",
                 "r");

    if (maps != NULL)
    {
        int count = 0;

        while (count < 12 &&
               fgets(line,
                     sizeof(line),
                     maps) != NULL)
        {
            fputs(line,
                  stdout);

            count++;
        }

        fclose(maps);
    }
    else
    {
        perror("/proc/self/maps");
    }

    printf("\nDynamic allocation: malloc()\n");

    heap_data = malloc(128);

    if (heap_data != NULL)
    {
        strcpy(heap_data,
               "Dynamic memory allocated in user space.");

        printf("Heap data: %s\n",
               heap_data);

        free(heap_data);
    }

    printf("\nMemory mapping: mmap()\n");

    region_size =
        page_size * 2;

    region =
        mmap(NULL,
             region_size,
             PROT_READ | PROT_WRITE,
             MAP_PRIVATE | MAP_ANONYMOUS,
             -1,
             0);

    if (region == MAP_FAILED)
    {
        perror("mmap");
    }
    else
    {
        memset(region,
               0,
               region_size);

        printf("Mapped %zu bytes at virtual address %p\n",
               region_size,
               region);

        if (munmap(region,
                   region_size) != 0)
        {
            perror("munmap");
        }
    }

    printf("\nMemory concepts demonstrated:\n");

    printf("- Virtual address space via /proc/self/maps\n");
    printf("- Dynamic allocation via malloc/free\n");
    printf("- Memory mapping via mmap/munmap\n");
    printf("- Linux demand paging is handled by the kernel\n");
    printf("- fork() uses Linux copy-on-write semantics\n");
}

/* ============================================================
   CO-5: FILE SYSTEMS AND FILE I/O
   ============================================================ */

static void co5_file_demo(void)
{
    int fd;

    const char data[] =
        "Linux systems programming file I/O demonstration.\n";

    char buf[256] = {0};

    struct stat st;

    struct statvfs vfs;

    struct statfs sfs;

    ssize_t n;

    clear_screen();

    printf("================ CO-5: FILE SYSTEMS =================\n\n");

    fd = open(TEST_FILE,
              O_CREAT | O_TRUNC | O_RDWR,
              0600);

    if (fd < 0)
    {
        perror("open");
        return;
    }

    n = write(fd,
              data,
              sizeof(data) - 1);

    if (n < 0)
    {
        perror("write");
    }
    else
    {
        printf("write() wrote %zd bytes\n",
               n);
    }

    if (lseek(fd,
              0,
              SEEK_SET) == (off_t)-1)
    {
        perror("lseek");
    }

    n = read(fd,
             buf,
             sizeof(buf) - 1);

    if (n < 0)
    {
        perror("read");
    }
    else
    {
        buf[n] = '\0';

        printf("read() returned %zd bytes: %s",
               n,
               buf);
    }

    if (fstat(fd,
              &st) == 0)
    {
        printf("File descriptor      : %d\n",
               fd);

        printf("Inode                : %lu\n",
               (unsigned long)st.st_ino);

        printf("File size            : %lld bytes\n",
               (long long)st.st_size);

        printf("Permissions          : %o\n",
               (unsigned)(st.st_mode & 0777));

        printf("Device major:minor   : %u:%u\n",
               major(st.st_dev),
               minor(st.st_dev));
    }

    close(fd);

    if (statvfs("/",
                &vfs) == 0)
    {
        unsigned long long total =
            (unsigned long long)vfs.f_blocks *
            vfs.f_frsize;

        unsigned long long freeb =
            (unsigned long long)vfs.f_bavail *
            vfs.f_frsize;

        printf("\nRoot filesystem capacity: %.2f GB\n",
               total /
               (1024.0 * 1024.0 * 1024.0));

        printf("Root filesystem free    : %.2f GB\n",
               freeb /
               (1024.0 * 1024.0 * 1024.0));
    }

    if (statfs("/",
               &sfs) == 0)
    {
        printf("Filesystem magic         : 0x%lx\n",
               (unsigned long)sfs.f_type);

        if ((unsigned long)sfs.f_type ==
            EXT4_SUPER_MAGIC)
        {
            printf("Filesystem type          : ext4\n");
        }
        else
        {
            printf("Filesystem type          : not ext4\n");
        }
    }

    {
        int dirfd =
            open("/tmp",
                 O_RDONLY | O_DIRECTORY);

        if (dirfd >= 0)
        {
            printf("Directory abstraction    : "
                   "/tmp opened as fd %d\n",
                   dirfd);

            close(dirfd);
        }
    }

    if (unlink(TEST_FILE) != 0)
        perror("unlink");

    printf("\nDemonstrated:\n");

    printf("- Unix file descriptors\n");
    printf("- open/read/write/lseek\n");
    printf("- inode information\n");
    printf("- directory abstraction\n");
    printf("- filesystem statistics\n");
    printf("- unbuffered file I/O\n");
    printf("- VFS provides a common interface to filesystems\n");
}

/* ============================================================
   CO-6: CONCURRENCY AND SYNCHRONIZATION
   ============================================================ */

static pthread_mutex_t counter_mutex =
    PTHREAD_MUTEX_INITIALIZER;

static pthread_cond_t counter_cond =
    PTHREAD_COND_INITIALIZER;

static sem_t slots;

static long long shared_counter = 0;

static int workers_finished = 0;

static void *counter_worker(void *arg)
{
    long id = (long)arg;

    int i;

    for (i = 0;
         i < ITERATIONS;
         ++i)
    {
        if (pthread_mutex_lock(&counter_mutex) != 0)
            break;

        shared_counter++;

        pthread_mutex_unlock(&counter_mutex);
    }

    if (sem_wait(&slots) == 0)
    {
        printf("Thread %ld acquired counting semaphore\n",
               id);

        if (pthread_mutex_lock(&counter_mutex) == 0)
        {
            workers_finished++;

            pthread_cond_signal(&counter_cond);

            pthread_mutex_unlock(&counter_mutex);
        }

        sem_post(&slots);
    }

    return NULL;
}

static void co6_thread_demo(void)
{
    pthread_t threads[THREAD_COUNT];

    int i;

    int created = 0;

    long long expected;

    clear_screen();

    printf("================ CO-6: CONCURRENCY =================\n\n");

    printf("Creating %d POSIX threads.\n",
           THREAD_COUNT);

    printf("Each thread increments a shared counter %d times.\n",
           ITERATIONS);

    shared_counter = 0;

    workers_finished = 0;

    if (sem_init(&slots,
                 0,
                 2) != 0)
    {
        perror("sem_init");
        return;
    }

    for (i = 0;
         i < THREAD_COUNT;
         ++i)
    {
        if (pthread_create(
                &threads[i],
                NULL,
                counter_worker,
                (void *)(long)(i + 1)) != 0)
        {
            perror("pthread_create");
            break;
        }

        created++;
    }

    expected =
        (long long)created *
        ITERATIONS;

    if (pthread_mutex_lock(&counter_mutex) == 0)
    {
        while (workers_finished < created)
        {
            pthread_cond_wait(
                &counter_cond,
                &counter_mutex);
        }

        pthread_mutex_unlock(&counter_mutex);
    }

    for (i = 0;
         i < created;
         ++i)
    {
        pthread_join(
            threads[i],
            NULL);
    }

    printf("\nThreads completed     : %d\n",
           created);

    printf("Expected counter      : %lld\n",
           expected);

    printf("Actual counter        : %lld\n",
           shared_counter);

    printf("Synchronization       : "
           "mutex + condition variable + semaphore\n");

    printf("Race condition avoided: "
           "shared counter protected by mutex\n");

    printf("Deadlock prevention   : "
           "consistent lock ownership and no lock cycle\n");

    sem_destroy(&slots);
}

