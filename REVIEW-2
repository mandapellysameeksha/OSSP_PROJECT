/* CO-2 : Process creation, execution and synchronization */

void process_demo()
{
    pid_t child_pid;

    int status;


    printf("\n");
    printf("============================================================\n");
    printf("             CO-2 : PROCESS CONTROL\n");
    printf("============================================================\n");


    printf("\nParent Process\n");

    printf("Parent PID : %ld\n",
           (long)getpid());


    /* ------------------------------------------------------------
       CO-2 : Process creation using fork()
       ------------------------------------------------------------ */

    printf("\nCreating child process using fork()...\n");


    child_pid =
        fork();


    if (child_pid < 0)
    {
        perror("fork");

        return;
    }


    /* ------------------------------------------------------------
       CO-2 : Child process
       ------------------------------------------------------------ */

    if (child_pid == 0)
    {
        printf("\nCHILD PROCESS\n");

        printf("Child PID  : %ld\n",
               (long)getpid());

        printf("Parent PID : %ld\n",
               (long)getppid());


        /* --------------------------------------------------------
           CO-2 : Process execution using exec()
           -------------------------------------------------------- */

        printf("\nExecuting external program using exec()...\n");

        printf("Command: uname -a\n\n");


        execlp("uname",
               "uname",
               "-a",
               (char *)NULL);


        /*
           Reached only if exec fails.
        */

        perror("execlp");

        _exit(127);
    }


    /* ------------------------------------------------------------
       CO-2 : Parent process synchronization
       ------------------------------------------------------------ */

    printf("\nPARENT PROCESS\n");

    printf("Child PID : %ld\n",
           (long)child_pid);


    printf("\nParent waiting for child using waitpid()...\n");


    if (waitpid(child_pid,
                &status,
                0) < 0)
    {
        perror("waitpid");

        return;
    }


    /* ------------------------------------------------------------
       CO-2 : Process termination
       ------------------------------------------------------------ */

    printf("\nPROCESS TERMINATION\n");


    if (WIFEXITED(status))
    {
        printf("Child terminated normally.\n");

        printf("Exit Status : %d\n",
               WEXITSTATUS(status));
    }
    else
    {
        printf("Child did not terminate normally.\n");
    }


    printf("\n");
    printf("CO-2 implementation includes:\n");

    printf("fork()    -> Process creation\n");

    printf("exec()    -> Process execution\n");

    printf("waitpid() -> Process synchronization\n");

    printf("exit      -> Process termination\n");


    printf("============================================================\n");
}


