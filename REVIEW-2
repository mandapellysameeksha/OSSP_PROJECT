/* ------------------------------------------------------------
   CO-3 : Anonymous Pipe
   ------------------------------------------------------------ */

void anonymous_pipe_demo()
{
    int pipe_fd[2];

    pid_t child_pid;


    printf("\n");
    printf("------------------------------------------------------------\n");
    printf("CO-3 : ANONYMOUS PIPE\n");
    printf("------------------------------------------------------------\n");


    /*
       CO-3 : Create anonymous pipe

       pipe_fd[0] = read end
       pipe_fd[1] = write end
    */

    if (pipe(pipe_fd) == -1)
    {
        perror("pipe");

        return;
    }


    child_pid =
        fork();


    if (child_pid < 0)
    {
        perror("fork");

        close(pipe_fd[0]);
        close(pipe_fd[1]);

        return;
    }


    /* ------------------------------------------------------------
       CO-3 : Child writes to pipe
       ------------------------------------------------------------ */

    if (child_pid == 0)
    {
        const char message[] =
            "Hello from child through anonymous pipe!";


        close(pipe_fd[0]);


        write(pipe_fd[1],
              message,
              sizeof(message));


        close(pipe_fd[1]);


        _exit(0);
    }


    /* ------------------------------------------------------------
       CO-3 : Parent reads from pipe
       ------------------------------------------------------------ */

    else
    {
        char buffer[200];


        memset(buffer,
               0,
               sizeof(buffer));


        close(pipe_fd[1]);


        read(pipe_fd[0],
             buffer,
             sizeof(buffer) - 1);


        printf("Parent received:\n");

        printf("%s\n",
               buffer);


        close(pipe_fd[0]);


        waitpid(child_pid,
                NULL,
                0);
    }


    printf("\nAnonymous pipe communication completed.\n");
}


/* ------------------------------------------------------------
   CO-3 : Named Pipe / FIFO
   ------------------------------------------------------------ */

void named_pipe_demo()
{
    pid_t child_pid;


    printf("\n");
    printf("------------------------------------------------------------\n");
    printf("CO-3 : NAMED PIPE / FIFO\n");
    printf("------------------------------------------------------------\n");


    /*
       CO-3 : Create named pipe
    */

    if (mkfifo(FIFO_PATH,
               0600) == -1)
    {
        if (errno != EEXIST)
        {
            perror("mkfifo");

            return;
        }
    }


    child_pid =
        fork();


    if (child_pid < 0)
    {
        perror("fork");

        unlink(FIFO_PATH);

        return;
    }


    /* ------------------------------------------------------------
       CO-3 : Child writes to FIFO
       ------------------------------------------------------------ */

    if (child_pid == 0)
    {
        int fifo_fd;

        const char message[] =
            "Hello through named FIFO!";


        fifo_fd =
            open(FIFO_PATH,
                 O_WRONLY);


        if (fifo_fd == -1)
        {
            perror("FIFO open");

            _exit(1);
        }


        write(fifo_fd,
              message,
              sizeof(message));


        close(fifo_fd);

        _exit(0);
    }


    /* ------------------------------------------------------------
       CO-3 : Parent reads from FIFO
       ------------------------------------------------------------ */

    else
    {
        int fifo_fd;

        char buffer[200];


        memset(buffer,
               0,
               sizeof(buffer));


        fifo_fd =
            open(FIFO_PATH,
                 O_RDONLY);


        if (fifo_fd == -1)
        {
            perror("FIFO open");
        }
        else
        {
            read(fifo_fd,
                 buffer,
                 sizeof(buffer) - 1);


            printf("Parent received:\n");

            printf("%s\n",
                   buffer);


            close(fifo_fd);
        }


        waitpid(child_pid,
                NULL,
                0);


        /*
           CO-3 : Remove FIFO
        */

        unlink(FIFO_PATH);
    }


    printf("\nNamed FIFO communication completed.\n");
}


/* ------------------------------------------------------------
   CO-3 : Signal Handler
   ------------------------------------------------------------ */

void usr1_handler(int signal_number)
{
    (void)signal_number;

    signal_count++;
}


/* ------------------------------------------------------------
   CO-3 : Signals and Asynchronous Notification
   ------------------------------------------------------------ */

void signal_demo()
{
    struct sigaction action;


    printf("\n");
    printf("------------------------------------------------------------\n");
    printf("CO-3 : SIGNALS AND ASYNCHRONOUS NOTIFICATION\n");
    printf("------------------------------------------------------------\n");


    memset(&action,
           0,
           sizeof(action));


    action.sa_handler =
        usr1_handler;


    sigemptyset(&action.sa_mask);


    /*
       CO-3 : Register signal handler
    */

    if (sigaction(SIGUSR1,
                  &action,
                  NULL) == -1)
    {
        perror("sigaction");

        return;
    }


    signal_count = 0;


    printf("Current PID : %ld\n",
           (long)getpid());


    printf("\nSending SIGUSR1...\n");


    /*
       CO-3 : Send signal
    */

    if (kill(getpid(),
             SIGUSR1) == -1)
    {
        perror("kill");

        return;
    }


    printf("Signal handler executed.\n");

    printf("Signal count : %d\n",
           (int)signal_count);


    printf("\nAsynchronous signal notification completed.\n");
}


