/* CO-1 : Signal handling for safe program termination */

void sigint_handler(int signal_number)
{
    (void)signal_number;
    running = 0;
}


/* CO-1 : Reading CPU information from Linux /proc filesystem */

unsigned long long read_cpu(unsigned long long *idle_time)
{
    FILE *file;

    unsigned long long user = 0;
    unsigned long long nice = 0;
    unsigned long long system = 0;
    unsigned long long idle = 0;
    unsigned long long iowait = 0;
    unsigned long long irq = 0;
    unsigned long long softirq = 0;
    unsigned long long steal = 0;

    file = fopen("/proc/stat", "r");

    if (file == NULL)
    {
        return 0;
    }

    fscanf(file,
           "cpu %llu %llu %llu %llu %llu %llu %llu %llu",
           &user,
           &nice,
           &system,
           &idle,
           &iowait,
           &irq,
           &softirq,
           &steal);

    fclose(file);

    *idle_time = idle + iowait;

    return user + nice + system + idle +
           iowait + irq + softirq + steal;
}


/* CO-1 : Reading memory information from Linux /proc filesystem */

void read_memory(unsigned long long *total,
                 unsigned long long *available)
{
    FILE *file;

    char key[64];
    char unit[32];

    unsigned long long value;

    *total = 0;
    *available = 0;

    file = fopen("/proc/meminfo", "r");

    if (file == NULL)
    {
        return;
    }

    while (fscanf(file,
                   "%63s %llu %31s",
                   key,
                   &value,
                   unit) == 3)
    {
        if (strcmp(key, "MemTotal:") == 0)
        {
            *total = value;
        }

        if (strcmp(key, "MemAvailable:") == 0)
        {
            *available = value;
        }
    }

    fclose(file);
}


/* CO-1 : Display Linux system information */

void display_system_information(double cpu_usage)
{
    struct utsname system_info;

    char hostname[256];

    FILE *uptime_file;

    double uptime_seconds = 0;

    unsigned long long memory_total;
    unsigned long long memory_available;

    struct statvfs disk;


    /* Clear terminal */

    printf("\033[2J");
    printf("\033[H");


    printf("====================================================================\n");
    printf("             LINUX SYSTEM INFORMATION MONITOR\n");
    printf("====================================================================\n");


    /* ------------------------------------------------------------
       CO-1 : Linux system information
       ------------------------------------------------------------ */

    printf("\n[ CO-1 : OS AS A SERVICE LAYER ]\n");

    printf("\nSYSTEM INFORMATION\n");


    /*
       CO-1 : uname()

       This is a system interface used to obtain
       information supplied by the Linux kernel.
    */

    if (uname(&system_info) == 0)
    {
        /*
           CO-1 : gethostname()
        */

        gethostname(hostname,
                    sizeof(hostname) - 1);

        hostname[sizeof(hostname) - 1] = '\0';


        printf("Operating System : %s\n",
               system_info.sysname);

        printf("Kernel Version   : %s\n",
               system_info.release);

        printf("Architecture     : %s\n",
               system_info.machine);

        printf("Hostname         : %s\n",
               hostname);
    }


    /* ------------------------------------------------------------
       CO-1 : Linux uptime
       ------------------------------------------------------------ */

    uptime_file = fopen("/proc/uptime", "r");

    if (uptime_file != NULL)
    {
        if (fscanf(uptime_file,
                   "%lf",
                   &uptime_seconds) == 1)
        {
            printf("System Uptime    : %.2f hours\n",
                   uptime_seconds / 3600.0);
        }

        fclose(uptime_file);
    }


    /* ------------------------------------------------------------
       CO-1 : CPU and memory resources
       ------------------------------------------------------------ */

    printf("\nRESOURCE UTILIZATION\n");


    if (cpu_usage < 0)
    {
        printf("CPU Usage        : Collecting data...\n");
    }
    else
    {
        printf("CPU Usage        : %.2f %%\n",
               cpu_usage);
    }


    read_memory(&memory_total,
                &memory_available);


    if (memory_total > 0)
    {
        double memory_used;

        memory_used =
            ((double)(memory_total - memory_available)
             / memory_total) * 100.0;


        printf("Memory Usage     : %.2f %%\n",
               memory_used);

        printf("Memory Used      : %.2f MB\n",
               (memory_total - memory_available)
               / 1024.0);

        printf("Total Memory     : %.2f MB\n",
               memory_total / 1024.0);
    }


    /* ------------------------------------------------------------
       CO-1 : Disk information
       ------------------------------------------------------------ */

    if (statvfs("/", &disk) == 0)
    {
        unsigned long long total_space;
        unsigned long long used_space;


        total_space =
            (unsigned long long)disk.f_blocks *
            disk.f_frsize;


        used_space =
            (unsigned long long)
            (disk.f_blocks - disk.f_bfree) *
            disk.f_frsize;


        if (total_space > 0)
        {
            printf("Root Disk Usage  : %.2f %%\n",
                   100.0 *
                   (double)used_space /
                   total_space);
        }
    }


    /* ------------------------------------------------------------
       CO-1 : Process information
       ------------------------------------------------------------ */

    printf("\nPROCESS CONTEXT\n");


    /*
       CO-1 : System calls
    */

    printf("Current PID      : %ld\n",
           (long)getpid());

    printf("Parent PID       : %ld\n",
           (long)getppid());

    printf("Process Group ID : %ld\n",
           (long)getpgrp());

    printf("Session ID       : %ld\n",
           (long)getsid(0));

    printf("Process Priority : %d\n",
           getpriority(PRIO_PROCESS, 0));


    /* ------------------------------------------------------------
       CO-1 : Shell and command execution
       ------------------------------------------------------------ */

    printf("\nRUNNING PROCESSES\n");

    printf("-----------------------------------------------\n");

    printf("PID      PPID     STATE     COMMAND\n");

    printf("-----------------------------------------------\n");


    /*
       CO-1 : popen()

       popen() starts a shell command.

       Shell executes:
       ps -eo pid,ppid,state,comm --sort=-%cpu

       This demonstrates the role of the shell as
       a user-space program.
    */

    FILE *process_file;


    process_file =
        popen("ps -eo pid,ppid,state,comm --sort=-%cpu | head -n 8",
              "r");


    if (process_file != NULL)
    {
        char line[256];


        while (fgets(line,
                     sizeof(line),
                     process_file) != NULL)
        {
            printf("%s", line);
        }


        pclose(process_file);
    }


    printf("\n");

    printf("Auto Refresh     : Every %d seconds\n",
           REFRESH_TIME);

    printf("Press Ctrl+C to exit.\n");

    printf("====================================================================\n");

    fflush(stdout);
}


/* CO-1 : Main monitoring loop */

void run_monitor()
{
    struct sigaction action;


    memset(&action,
           0,
           sizeof(action));


    action.sa_handler =
        sigint_handler;


    sigemptyset(&action.sa_mask);


    sigaction(SIGINT,
              &action,
              NULL);


    unsigned long long idle1;
    unsigned long long idle2;

    unsigned long long total1;
    unsigned long long total2;


    total1 =
        read_cpu(&idle1);


    while (running)
    {
        struct timespec sleep_time;


        sleep_time.tv_sec =
            REFRESH_TIME;

        sleep_time.tv_nsec = 0;


        while (nanosleep(&sleep_time,
                         &sleep_time) == -1 &&
               errno == EINTR &&
               running)
        {
        }


        if (!running)
        {
            break;
        }


        total2 =
            read_cpu(&idle2);


        double cpu_usage = -1;


        if (total2 > total1)
        {
            unsigned long long total_difference;
            unsigned long long idle_difference;


            total_difference =
                total2 - total1;


            idle_difference =
                idle2 - idle1;


            cpu_usage =
                100.0 *
                ((double)total_difference -
                 (double)idle_difference)
                /
                (double)total_difference;
        }


        display_system_information(cpu_usage);


        total1 = total2;
        idle1 = idle2;
    }


    printf("\nMonitoring stopped safely.\n");
}


